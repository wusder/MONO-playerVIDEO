{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mono Player",
  "version": "1.0.0",
  "identifier": "app.mono.player",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:8443",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Mono Player",
        "width": 1360,
        "height": 860,
        "minWidth": 960,
        "minHeight": 620,
        "decorations": false,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-blink-features=AudioVideoTracks --autoplay-policy=no-user-gesture-required"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": { "enable": true, "scope": ["**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
